# PrimalSolver example -- a tiny quadratic program in OPF format.
# (The quadratic objective is not representable in LP; OPF and MPS are.)
#
#   minimize    x0^2 + x1^2        (written as 0.5 * (2 x0^2 + 2 x1^2))
#   subject to  x0 + x1 = 1
#               x0, x1 >= 0
#
# Solution: x = (0.5, 0.5), objective 0.5.
#
# Run:  primal examples/qp_portfolio.opf
[objective minimize 'risk']
0.5 ( 2.0 x0 ^ 2 + 2.0 x1 ^ 2 )
[/objective]
[constraints]
[con 'budget'] x0 + x1 = 1.0 [/con]
[/constraints]
[bounds]
[b] 0 <= * [/b]
[/bounds]
